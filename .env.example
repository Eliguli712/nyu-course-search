# Core
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=prod

# PostgreSQL (Railway provides this as DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nyu_courses

# Redis (Railway provides this as REDIS_URL)
REDIS_URL=redis://default:password@host:6379

# Auth
SESSION_COOKIE_NAME=nyu_course_session
SESSION_MAX_AGE_SECONDS=1209600   # 14 days
NYU_EMAIL_DOMAIN=nyu.edu

# Scraping targets (defaults are correct for production)
BULLETINS_COURSES_ROOT=https://bulletins.nyu.edu/courses/
BULLETINS_CLASS_SEARCH_ROOT=https://bulletins.nyu.edu/class-search/

# Embedding model
EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=32
